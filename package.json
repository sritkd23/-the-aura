import React, { useState } from 'react';
import { Heart, ShoppingCart, User, Plus, Trash2, X, Shield, ArrowRight } from 'lucide-react';

export default function App() {
  // Sample initial store products
  const [products, setProducts] = useState([
    { id: 1, name: 'Customized Photo Frame', price: 499, image: 'https://via.placeholder.com/200?text=Photo+Frame' },
    { id: 2, name: 'Handmade Gift Hamper', price: 1299, image: 'https://via.placeholder.com/200?text=Gift+Hamper' },
  ]);

  // State Management
  const [cart, setCart] = useState([]);
  const [wishlist, setWishlist] = useState([]);
  const [isAdmin, setIsAdmin] = useState(false);
  const [activeModal, setActiveModal] = useState(null); // 'cart' | 'wishlist' | 'login' | 'admin' | null

  // New Product Form State (Admin)
  const [newProductName, setNewProductName] = useState('');
  const [newProductPrice, setNewProductPrice] = useState('');

  // Cart & Wishlist Actions
  const toggleWishlist = (product) => {
    if (wishlist.some((item) => item.id === product.id)) {
      setWishlist(wishlist.filter((item) => item.id !== product.id));
    } else {
      setWishlist([...wishlist, product]);
    }
  };

  const addToCart = (product) => {
    const existing = cart.find((item) => item.id === product.id);
    if (existing) {
      setCart(cart.map((item) => item.id === product.id ? { ...item, quantity: item.quantity + 1 } : item));
    } else {
      setCart([...cart, { ...product, quantity: 1 }]);
    }
  };

  const updateQuantity = (id, delta) => {
    setCart(cart.map((item) => {
      if (item.id === id) {
        const newQty = item.quantity + delta;
        return newQty > 0 ? { ...item, quantity: newQty } : null;
      }
      return item;
    }).filter(Boolean));
  };

  const removeFromCart = (id) => {
    setCart(cart.filter((item) => item.id !== id));
  };

  const calculateTotal = () => cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

  // Admin Actions
  const handleAddProduct = (e) => {
    e.preventDefault();
    if (!newProductName || !newProductPrice) return;
    const newProduct = {
      id: Date.now(),
      name: newProductName,
      price: parseFloat(newProductPrice),
      image: 'https://via.placeholder.com/200?text=New+Product',
    };
    setProducts([...products, newProduct]);
    setNewProductName('');
    setNewProductPrice('');
  };

  const handleDeleteProduct = (id) => {
    setProducts(products.filter((p) => p.id !== id));
    setCart(cart.filter((item) => item.id !== id));
    setWishlist(wishlist.filter((item) => item.id !== id));
  };

  return (
    <div className="min-h-screen bg-slate-50 font-sans text-slate-800">
      {/* HEADER / NAVBAR */}
      <header className="bg-white border-b border-slate-200 sticky top-0 z-40">
        <div className="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
          <div>
            <h1 className="text-2xl font-bold tracking-tight text-slate-900">The Aura</h1>
            <p className="text-xs text-slate-500 uppercase tracking-widest font-medium">Gifts Made With Love</p>
          </div>

          <div className="flex items-center gap-3">
            {/* Admin Switcher Toggle */}
            <button
              onClick={() => setIsAdmin(!isAdmin)}
              className={`px-3 py-1.5 rounded-full text-xs font-semibold flex items-center gap-1 transition ${
                isAdmin ? 'bg-purple-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
              }`}
            >
              <Shield className="w-3.5 h-3.5" />
              {isAdmin ? 'Admin Mode ON' : 'User Mode'}
            </button>

            {/* Wishlist Button */}
            <button
              onClick={() => setActiveModal('wishlist')}
              className="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-pink-50 text-pink-600 hover:bg-pink-100 text-sm font-medium transition"
            >
              <Heart className="w-4 h-4 fill-current" />
              <span>Wishlist</span>
              <span className="bg-pink-200 text-pink-800 text-xs px-1.5 py-0.5 rounded-full font-bold">
                {wishlist.length}
              </span>
            </button>

            {/* Cart Button */}
            <button
              onClick={() => setActiveModal('cart')}
              className="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-100 text-sm font-medium transition"
            >
              <ShoppingCart className="w-4 h-4" />
              <span>Cart</span>
              <span className="bg-indigo-200 text-indigo-800 text-xs px-1.5 py-0.5 rounded-full font-bold">
                {cart.reduce((total, item) => total + item.quantity, 0)}
              </span>
            </button>

            {/* Login / Customer Info Button */}
            <button
              onClick={() => setActiveModal('login')}
              className="flex items-center gap-1 px-3 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium transition"
            >
              <User className="w-4 h-4" />
              <span>Login / Customer Info</span>
            </button>
          </div>
        </div>
      </header>

      {/* HERO SECTION */}
      <section className="bg-gradient-to-b from-indigo-50/50 to-slate-50 py-12 px-4 text-center">
        <div className="max-w-2xl mx-auto">
          <span className="inline-block px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-bold tracking-wider uppercase mb-3">
            WELCOME TO THE AURA
          </span>
          <h2 className="text-4xl font-extrabold text-slate-900 mb-2 italic">Little things. Big feelings.</h2>
          <p className="text-slate-600 mb-6">Beautiful gifts and thoughtful surprises, made specially for your special people.</p>
          <a
            href="#shop"
            className="inline-flex items-center gap-2 bg-slate-900 text-white px-6 py-2.5 rounded-full text-sm font-medium hover:bg-slate-800 transition"
          >
            Explore Collection <ArrowRight className="w-4 h-4" />
          </a>
        </div>
      </section>

      {/* MAIN CONTENT AREA */}
      <main id="shop" className="max-w-6xl mx-auto px-4 py-8">
        {/* ADMIN MANAGEMENT PANEL (Visible when Admin Mode is ON) */}
        {isAdmin && (
          <div className="mb-10 bg-purple-50 border border-purple-200 rounded-xl p-6">
            <h3 className="text-lg font-bold text-purple-900 mb-4 flex items-center gap-2">
              <Shield className="w-5 h-5 text-purple-600" /> Admin Control Panel
            </h3>
            <form onSubmit={handleAddProduct} className="flex flex-wrap gap-3 items-center">
              <input
                type="text"
                placeholder="Product Name"
                value={newProductName}
                onChange={(e) => setNewProductName(e.target.value)}
                className="px-3 py-2 border rounded-lg text-sm flex-1 min-w-[200px]"
              />
              <input
                type="number"
                placeholder="Price (₹)"
                value={newProductPrice}
                onChange={(e) => setNewProductPrice(e.target.value)}
                className="px-3 py-2 border rounded-lg text-sm w-32"
              />
              <button
                type="submit"
                className="bg-purple-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-purple-700 flex items-center gap-1"
              >
                <Plus className="w-4 h-4" /> Add Product
              </button>
            </form>
          </div>
        )}

        {/* PRODUCTS GRID */}
        <h3 className="text-xl font-bold text-slate-900 mb-6">Our Collection</h3>
        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {products.map((product) => {
            const isWishlisted = wishlist.some((item) => item.id === product.id);
            return (
              <div key={product.id} className="bg-white border rounded-xl overflow-hidden shadow-sm hover:shadow-md transition">
                <img src={product.image} alt={product.name} className="w-full h-48 object-cover" />
                <div className="p-4">
                  <div className="flex justify-between items-start mb-2">
                    <h4 className="font-semibold text-slate-800">{product.name}</h4>
                    <button onClick={() => toggleWishlist(product)} className="text-slate-400 hover:text-pink-500">
                      <Heart className={`w-5 h-5 ${isWishlisted ? 'fill-pink-500 text-pink-500' : ''}`} />
                    </button>
                  </div>
                  <p className="text-slate-900 font-bold mb-4">₹{product.price}</p>
                  
                  <div className="flex gap-2">
                    <button
                      onClick={() => addToCart(product)}
                      className="flex-1 bg-indigo-600 text-white py-2 rounded-lg text-sm font-medium hover:bg-indigo-700 transition"
                    >
                      Add to Cart
                    </button>
                    {isAdmin && (
                      <button
                        onClick={() => handleDeleteProduct(product.id)}
                        className="p-2 border border-red-200 text-red-600 hover:bg-red-50 rounded-lg transition"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </main>

      {/* MODALS */}
      {activeModal && (
        <div className="fixed inset-0 bg-black/40 z-50 flex justify-end">
          <div className="bg-white w-full max-w-md h-full p-6 overflow-y-auto flex flex-col justify-between shadow-xl">
            <div>
              {/* Modal Header */}
              <div className="flex justify-between items-center pb-4 border-b">
                <h3 className="text-lg font-bold capitalize">{activeModal}</h3>
                <button onClick={() => setActiveModal(null)} className="p-1 hover:bg-slate-100 rounded-full">
                  <X className="w-5 h-5" />
                </button>
              </div>

              {/* CART MODAL CONTENT */}
              {activeModal === 'cart' && (
                <div className="mt-4">
                  {cart.length === 0 ? (
                    <div className="text-center py-12 text-slate-500">
                      <ShoppingCart className="w-12 h-12 mx-auto mb-3 stroke-1" />
                      <p>Your cart is empty.</p>
                    </div>
                  ) : (
                    <div className="space-y-4">
                      {cart.map((item) => (
                        <div key={item.id} className="flex justify-between items-center border-b pb-3">
                          <div>
                            <h5 className="font-semibold text-sm">{item.name}</h5>
                            <p className="text-xs text-slate-500">₹{item.price} each</p>
                          </div>
                          <div className="flex items-center gap-2">
                            <button onClick={() => updateQuantity(item.id, -1)} className="px-2 py-0.5 bg-slate-100 rounded text-xs">-</button>
                            <span className="text-xs font-bold">{item.quantity}</span>
                            <button onClick={() => updateQuantity(item.id, 1)} className="px-2 py-0.5 bg-slate-100 rounded text-xs">+</button>
                            <button onClick={() => removeFromCart(item.id)} className="text-red-500 ml-2">
                              <Trash2 className="w-4 h-4" />
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}

              {/* WISHLIST MODAL CONTENT */}
              {activeModal === 'wishlist' && (
                <div className="mt-4">
                  {wishlist.length === 0 ? (
                    <div className="text-center py-12 text-slate-500">
                      <Heart className="w-12 h-12 mx-auto mb-3 stroke-1" />
                      <p>Your wishlist is empty.</p>
                    </div>
                  ) : (
                    <div className="space-y-4">
                      {wishlist.map((item) => (
                        <div key={item.id} className="flex justify-between items-center border-b pb-3">
                          <div>
                            <h5 className="font-semibold text-sm">{item.name}</h5>
                            <p className="text-xs text-slate-500">₹{item.price}</p>
                          </div>
                          <button
                            onClick={() => { addToCart(item); toggleWishlist(item); }}
                            className="text-xs bg-indigo-50 text-indigo-600 px-3 py-1.5 rounded-full font-medium"
                          >
                            Move to Cart
                          </button>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}

              {/* LOGIN / CUSTOMER INFO MODAL */}
              {activeModal === 'login' && (
                <div className="mt-6 space-y-4">
                  <h4 className="font-semibold text-sm">Customer Profile</h4>
                  <input type="text" placeholder="Full Name" className="w-full px-3 py-2 border rounded-lg text-sm" />
                  <input type="email" placeholder="Email Address" className="w-full px-3 py-2 border rounded-lg text-sm" />
                  <button className="w-full bg-slate-900 text-white py-2 rounded-lg text-sm font-medium">Save Details</button>
                </div>
              )}
            </div>

            {/* CART FOOTER / CHECKOUT */}
            {activeModal === 'cart' && cart.length > 0 && (
              <div className="border-t pt-4">
                <div className="flex justify-between items-center mb-4">
                  <span className="font-medium text-slate-600">Total Amount:</span>
                  <span className="text-xl font-bold text-slate-900">₹{calculateTotal()}</span>
                </div>
                <button
                  onClick={() => alert(`Proceeding to checkout with total amount: ₹${calculateTotal()}`)}
                  className="w-full bg-indigo-600 text-white py-3 rounded-xl font-medium hover:bg-indigo-700 transition"
                >
                  Proceed to Checkout
                </button>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
